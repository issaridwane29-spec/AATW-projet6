@startuml
left to right direction
skinparam packageStyle rectangle
title Diagramme de cas d'utilisation - Plateforme QR Code

actor Visiteur
actor Utilisateur
actor Administrateur
actor Scanneur

Utilisateur --|> Visiteur
Administrateur --|> Utilisateur

rectangle "Plateforme de génération et gestion de QR codes" {
  usecase "S'inscrire" as UC1
  usecase "Se connecter" as UC2
  usecase "Générer un QR code" as UC3
  usecase "Personnaliser (forme, couleur, logo)" as UC4
  usecase "Définir le nombre de scans" as UC5
  usecase "Modifier le nombre de scans" as UC6
  usecase "Télécharger le QR (PNG/SVG/PDF)" as UC7
  usecase "Activer / Désactiver / Supprimer un QR" as UC8
  usecase "Consulter l'historique des scans" as UC9
  usecase "Filtrer par période" as UC10
  usecase "Filtrer par zone géographique" as UC11
  usecase "Filtrer par adresse (IP)" as UC12
  usecase "Scanner un QR code" as UC13
  usecase "Vérifier le quota de scans" as UC14
  usecase "Enregistrer le scan" as UC15
  usecase "Rediriger vers le contenu" as UC16
  usecase "Gérer les utilisateurs" as UC17
  usecase "Superviser tous les QR codes" as UC18
  usecase "Consulter les statistiques globales" as UC19
}

Visiteur --> UC1
Visiteur --> UC2
Utilisateur --> UC3
Utilisateur --> UC5
Utilisateur --> UC6
Utilisateur --> UC7
Utilisateur --> UC8
Utilisateur --> UC9
Scanneur --> UC13
Administrateur --> UC17
Administrateur --> UC18
Administrateur --> UC19

UC3 ..> UC4 : <<extend>>
UC3 ..> UC5 : <<include>>
UC9 ..> UC10 : <<extend>>
UC9 ..> UC11 : <<extend>>
UC9 ..> UC12 : <<extend>>
UC13 ..> UC14 : <<include>>
UC13 ..> UC15 : <<include>>
UC13 ..> UC16 : <<include>>
@enduml
